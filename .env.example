# ============================================================
# Environment Variables — Copy this to .env and fill in values
# ============================================================

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secret

# --- Paths ---
DATA_DIR=data
MODELS_DIR=models
UPLOADS_DIR=data/uploads
PROCESSED_DIR=data/processed

# --- Database ---
DATABASE_PATH=data/disaster_intelligence.db

# --- Model Weights (relative to project root) ---
YOLO_MODEL_PATH=models/yolov8n.pt
DISASTER_CLASSIFIER_PATH=models/disaster_classifier/best_model.pth
TEXT_CLASSIFIER_PATH=models/text_classifier/best_model.pth
DAMAGE_ASSESSMENT_PATH=models/damage_assessment/best_model.pth
MULTIMODAL_MODEL_PATH=models/multimodal_model/best_model.pth

# --- Optional: Geocoding ---
# NOMINATIM_USER_AGENT=disaster_intelligence_system
# GEOCODING_ENABLED=false

# --- Hardware ---
# Set to: cuda, mps, or cpu (auto-detected if not set)
DEVICE=auto

# --- File Upload Limits ---
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500
ALLOWED_IMAGE_TYPES=jpg,jpeg,png
ALLOWED_VIDEO_TYPES=mp4,avi,mov

# --- Training ---
TRAINING_BATCH_SIZE=32
TRAINING_EPOCHS=50
TRAINING_LR=0.0001
TRAINING_WORKERS=4
