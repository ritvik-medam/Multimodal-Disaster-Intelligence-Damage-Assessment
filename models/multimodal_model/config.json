{
  "vision_encoder": "efficientnet_b2",
  "text_encoder": "distilbert-base-uncased",
  "fusion_method": "concat_mlp",
  "num_classes": 6,
  "fusion_hidden_dim": 512,
  "dropout": 0.3,
  "image_size": 224,
  "max_text_length": 128,
  "batch_size": 16,
  "epochs": 20,
  "learning_rate": 5e-05,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "patience": 5,
  "freeze_vision_encoder": false,
  "freeze_text_encoder": false,
  "dataset_name": "crisismmd_multimodal",
  "data_dir": "data/processed/multimodal",
  "splits_dir": "data/splits/multimodal",
  "run_comparison": true,
  "device": "auto",
  "num_workers": 2,
  "checkpoint_dir": "models/multimodal_model",
  "save_best_only": true,
  "checkpoint_metric": "val_f1_macro",
  "log_dir": "logs/multimodal",
  "seed": 42,
  "label_map": {
    "cyclone_storm": 0,
    "earthquake": 1,
    "flood": 2,
    "landslide": 3,
    "not_disaster": 4,
    "wildfire": 5
  }
}