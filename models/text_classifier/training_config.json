{
  "model_name": "distilbert-base-uncased",
  "num_classes": 6,
  "max_length": 128,
  "batch_size": 32,
  "epochs": 10,
  "learning_rate": 2e-05,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "patience": 3,
  "label_smoothing": 0.05,
  "dataset_name": "crisismmd_text",
  "data_dir": "data/processed/text_classifier",
  "splits_dir": "data/splits/text_classifier",
  "device": "auto",
  "num_workers": 2,
  "checkpoint_dir": "models/text_classifier",
  "save_best_only": true,
  "checkpoint_metric": "val_f1_macro",
  "log_dir": "logs/text_classifier",
  "seed": 42,
  "label_map": {
    "cyclone_storm": 0,
    "earthquake": 1,
    "flood": 2,
    "landslide": 3,
    "not_disaster": 4,
    "wildfire": 5
  }
}